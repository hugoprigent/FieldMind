<?xml version="1.0"?>
<package format="3">
  <name>fieldmind_pont</name>
  <version>0.1.0</version>
  <description>Pont entre les topics ROS 2 du rover FieldMind et le cerveau (protocole JSON sur WebSocket).</description>
  <maintainer email="maintainer@fieldmind.example">Hugo Prigent</maintainer>
  <license>Propriétaire</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
