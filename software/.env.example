# Copier ce fichier en software/.env (ignoré par git) et le compléter.
# Sans clé : chat par mots-clés, vision par le détecteur parfait de la simulation.

# ---------------------------------------------------------------- modèles (gratuits)
# Clé OpenRouter : chat et vision par des modèles GRATUITS uniquement (prix plafonné à zéro
# dans chaque requête, catalogue vérifié au démarrage). https://openrouter.ai/settings/keys
# Une variable d'environnement OPENROUTER_API_KEY définie ailleurs suffit aussi.
OPENROUTER_API_KEY=

# auto (OpenRouter si la clé existe, sinon mots-clés) | openrouter | openai | anthropic | aucun
# « openai » désigne toute API compatible OpenAI, dont vLLM sur le GX10 (modèle local, gratuit).
FIELDMIND_LLM_PROVIDER=auto
# Vide avec OpenRouter : stealth/space-bunny-alpha (gratuit, accepte les images).
FIELDMIND_LLM_MODEL=
# Modèles gratuits de secours, essayés par OpenRouter si le premier est indisponible.
FIELDMIND_LLM_MODELES_SECOURS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# Uniquement pour « openai » / « anthropic » : clé et adresse (ex. http://gx10.local:8000/v1)
FIELDMIND_LLM_API_KEY=
FIELDMIND_LLM_BASE_URL=
FIELDMIND_LLM_JETONS_MAX=1024
FIELDMIND_LLM_DELAI_S=20

# ---------------------------------------------------------------- vision (caméra avant)
# auto : même fournisseur que le chat (OpenRouter ou vLLM), sinon détecteur de la simulation
# auto | openrouter | openai | simulation | aucun
FIELDMIND_VISION_PROVIDER=auto
# Vide : le modèle du chat
FIELDMIND_VISION_MODEL=
# Vigilance active au démarrage : une image analysée toutes les N secondes pendant une mission,
# vitesse limitée à 0,6 m/s.
FIELDMIND_VISION_VIGILANCE=true
FIELDMIND_VISION_PERIODE_S=4
FIELDMIND_VISION_DELAI_S=45
FIELDMIND_VISION_JETONS_MAX=4000
FIELDMIND_VISION_MAX_PAR_SESSION=150
FIELDMIND_VISION_MAX_PAR_JOUR=1000

# ---------------------------------------------------------------- limites de la démo publique
FIELDMIND_SESSIONS_MAX=10
FIELDMIND_CHAT_MAX_PAR_SESSION=30
FIELDMIND_CHAT_MAX_PAR_JOUR=500
FIELDMIND_SESSION_INACTIVITE_S=600

# Pont du robot distant (/ws/robot) : jeton partagé avec le pont. Vide : accès fermé.
# Générer par exemple avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELDMIND_JETON_ROBOT=
