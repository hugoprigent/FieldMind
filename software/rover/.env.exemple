# Clé Gemini PAYANTE (prioritaire) : Gemini 4 Argon (agent, seule clé utilisée), Robotics ER 2
# (vision), transcription. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clé Gemini GRATUITE (secours) : même modèle, seulement si la payante est en quota dépassé ou
# en panne passagère, et seulement pour la vision et la transcription (jamais pour Argon).
GEMINI_API_KEY_GRATUITE=

# Facultatif : modèles locaux du GX10 (profil « gx10 », voir deploiement/gx10/README.md)
# GX10_API_KEY=
# FIELDMIND_GX10_HOTE=gx10.local

# Facultatif : jeton exigé par le poste web et le pont ROS 2 (réseau non sûr)
# FIELDMIND_JETON=
