# Copier en .env (à côté de docker-compose.yml) et remplir. Ne pas versionner le .env.

# Jeton Hugging Face : facultatif (Qwen3.6 et Qwen3-ASR sont sous Apache 2.0, sans licence
# à accepter) ; seulement pour un modèle à accès restreint.
HF_TOKEN=

# Clé demandée par les deux serveurs (vide : pas de clé, réseau de confiance seulement).
# Sur le rover : la même valeur dans software/rover/.env, variable GX10_API_KEY.
VLLM_API_KEY=

# Modèle multimodal (texte + images, appel de fonctions).
MODELE=nvidia/Qwen3.6-35B-A3B-NVFP4
ANALYSEUR_OUTILS=qwen3_xml
ANALYSEUR_REFLEXION=qwen3
LONGUEUR_MAX=32768
MEMOIRE_MODELE=0.45
# Options supplémentaires de vllm serve, par exemple poids en int8 (≈ moitié de mémoire, plus
# rapide sur le GB10) : --quantization int8_per_channel_weight_only
OPTIONS_MODELE=

# Transcription
MODELE_TRANSCRIPTION=Qwen/Qwen3-ASR-1.7B
MEMOIRE_TRANSCRIPTION=0.08

# Image vLLM (multi-architecture, CUDA 13.0) et cache des modèles.
VLLM_IMAGE=vllm/vllm-openai:v0.31.0
VLLM_VERSION=v0.31.0
HF_CACHE=~/.cache/huggingface

# Bind locally by default; set your private interface address for rover access.
FIELDMIND_BIND_IP=127.0.0.1
