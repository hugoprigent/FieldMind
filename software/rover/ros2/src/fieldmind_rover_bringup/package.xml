<?xml version="1.0"?>
<package format="3">
  <name>fieldmind_rover_bringup</name>
  <version>1.0.0</version>
  <description>Lancements du rover FieldMind réel : pont /ws/ros, description, slam_toolbox, Nav2 (Smac Hybrid-A*, MPPI Ackermann ou RPP), Foxglove bridge, RViz.</description>
  <maintainer email="maintainer@fieldmind.example">Hugo Prigent</maintainer>
  <license>Propriétaire</license>
  <exec_depend>fieldmind_rover_ros</exec_depend>
  <exec_depend>fieldmind_rover_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
